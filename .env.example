# Optional. Leave blank to use manual review.
META_MODEL_API_KEY=
# HOST defaults to 127.0.0.1. Use HTTPS for hosted demos.
PORT=3000
# Enable password-free, browser-scoped guest access for a hosted demo.
SHARESAFE_GUEST_MODE=0
# Required with a Meta key on a non-loopback address when guest mode is disabled.
SHARESAFE_DEMO_PASSWORD=
